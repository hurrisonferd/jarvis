  "state_machine": [
    {
      "from": "ACTIVE",
      "event": "REQUEST",
      "to": "SWITCH_PENDING"
    },
    {
      "from": "SWITCH_PENDING",
      "event": "CHECKPOINT",
      "to": "CHECKPOINTED"
    },
    {
