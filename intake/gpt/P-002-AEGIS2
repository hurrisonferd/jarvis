## 3. AEGIS CORE CHANGE (aegis.ts)

### 3.1 Add Threshold Evaluator

```ts
export function evaluateThreshold(input) {
  const score = computeRiskScore(input); // existing or injected heuristic
  const threshold = 0.72;

  const status =
    score < 0.5 ? "ok" :
    score < threshold ? "warning" :
    "critical";

  const action =
    status === "ok" ? "allow" :
    status === "warning" ? "flag" :
    "escalate";

  return {
    trace_id: input.trace_id,
    system: "AEGIS",
    mode: "threshold",
    decision_context: input.type,

    score,
    threshold,
    status,
    action,

    reasons: input.reasons ?? [],
    violated_rules: input.violations ?? [],

    routing_hint: {
      odin_intent: input.intent,
      suggested_sink: input.sink
    },

    metadata: {
      source_system: "AEGIS",
      patch_id: input.patch_id,
      correlation_id: input.trace_id
    },

    timestamp: new Date().toISOString()
  };
}
```

