## 5. ODIN CORE CHANGE (routing.ts)

### 5.1 New Routing Function

```ts id="odin_router"
export function route(input, aegis_signal) {
  const intent = classifyIntent(input);

  const index = MCP_INDEX[intent.primary];

  const risk = aegis_signal?.score ?? 0;

  const risk_band =
    risk < 0.5 ? "safe" :
    risk < 0.72 ? "warning" :
    "critical";

  return {
    trace_id: input.trace_id,

    intent,
    route: {
      target_sink: index.sink,
      execution_layer: index.system === "SKADI"
        ? "SKADI"
        : "MNEMOS"
    },

    mcp_index: index,

    risk_overlay: {
      score: risk,
      band: risk_band
    },

    metadata: {
      correlation_id: input.trace_id
    }
  };
}
```

