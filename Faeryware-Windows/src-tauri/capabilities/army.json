{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "army-capability",
  "description": "Faeryware transparent per-monitor desktop army. Read-only desktop topology/cursor sense plus explicit click-through; no effect authority.",
  "windows": ["army-*"],
  "permissions": [
    "core:default",
    "core:window:allow-set-ignore-cursor-events",
    "core:window:allow-cursor-position",
    "core:window:allow-available-monitors",
    "core:window:allow-outer-position",
    "core:window:allow-scale-factor"
  ]
}
