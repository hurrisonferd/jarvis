What This Looks Like in Code
TypeScript
// supabase/functions/eris-bridgekeeper/index.ts

export async function erisBridgekeeper(prMetadata: PR, answerHistory: Answer[]) {
// Measure entropy of PR intent
const prEntropy = await measureEntropy(prMetadata);

// If high entropy (chaotic, contradictory intent) → question
if (prEntropy > ENTROPY_THRESHOLD) {
const question = await generateQuestion(prMetadata, answerHistory);
return {
verdict: "CHALLENGE",
question,
entropy_score: prEntropy,
reasoning: "High entropy detected — clarify intent"
};
}

// If answer provided, measure entropy of answer vs. intent
if (answerHistory.length > 0) {
const lastAnswer = answerHistory[answerHistory.length - 1];
const answerEntropy = await measureEntropy(lastAnswer);
const coherence = await measureCoherence(prMetadata, lastAnswer);

// Coherence < threshold = evasion = higher entropy
if (coherence < COHERENCE_THRESHOLD) {
  const harderQuestion = await generateQuestion(
    prMetadata, 
    answerHistory,
    { difficulty: "escalate" }
  );
  return {
    verdict: "CHALLENGE_HARDER",
    question: harderQuestion,
    coherence_score: coherence,
    reasoning: "Answer did not reduce entropy — evasion detected"
  };
}
}

// If entropy resolves and Raven hasn't authorized → block
if (prEntropy === 0 && !isAuthorized(prMetadata.author)) {
return {
verdict: "BLOCKED",
reason: "No entropy, but not authorized. Access denied.",
audit_trail: answerHistory
};
}

// If Raven authorizes → allow
if (isAuthorized(prMetadata.author)) {
return {
verdict: "AUTHORIZED",
author: prMetadata.author,
audit_trail: answerHistory
};
}
}

async function measureEntropy(input: any): Promise<number> {
/**

Entropy measures chaos/contradiction in intent.
Low entropy: PR is coherent, goal is clear, changes match description
High entropy: PR claim contradicts changes, intent is unclear, touches unrelated systems
Uses:
Semantic similarity between PR description and actual code changes
Routing complexity (how many god systems touched?)
GL law violations (does it propose expansion without simplification?)
File modification pattern (coherent or scattered?)
*/
const semanticDrift = await comparePRDescriptionToCode(input);
const routingComplexity = countGodSystemsAffected(input);
const glViolations = checkGoldLawCompliance(input);
const fileCoherence = analyzeFileChangePattern(input);

return (semanticDrift * 0.4) +
(routingComplexity * 0.3) +
(glViolations * 0.2) +
(fileCoherence * 0.1);
}

async function measureCoherence(prMetadata: PR, answer: Answer): Promise<number> {
/**

Coherence measures consistency between answer and prior state.
High coherence: answer explains the PR well, no contradictions, shows understanding
Low coherence: answer evades the question, contradicts prior answers, generic/scripted
*/
const semanticMatch = await compareAnswerToPR(answer, prMetadata);
const contradictions = detectContradictions(answer, answerHistory);
const understanding = assessSystemKnowledge(answer);
const evasion = detectEvasionPatterns(answer);

return (semanticMatch * 0.4) +
((1 - contradictions) * 0.3) +
(understanding * 0.2) +
((1 - evasion) * 0.1);
}
