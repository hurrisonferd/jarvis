# ─── LOOP ─────────────────────────────────────────────────────────────────────
cmd_loop() {
    local n=$1
    shift
    local cmd="$*"
    
    if [ -z "$n" ] || [ -z "$cmd" ]; then
        echo -e "${RED}Usage: loop [n] [command]${NC}"
        return
    fi
    
    echo -e "${CYAN}Running '$cmd' $n times...${NC}"
    local i=1
    while [ $i -le $n ]; do
        echo -e "${WHITE}─── Iteration $i ───${NC}"
        eval "$cmd"
        i=$((i+1))
    done
    echo -e "${GREEN}✓ Loop complete${NC}"
}

