{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/musicos/receipt.v1.schema.json",
  "title": "MusicOS Public Receipt v1",
  "type": "object",
  "required": ["schema_version", "operation", "effect_class", "evidence", "claim_ceiling"],
  "properties": {
    "schema_version": {"const": "musicos.public-receipt.v1"},
    "operation": {"type": "string"},
    "effect_class": {"enum": ["READ", "COMPUTE", "PROPOSE", "WRITE", "UNKNOWN"]},
    "evidence": {"type": "array", "items": {"type": "object"}},
    "input_state_sha256": {"type": ["string", "null"]},
    "output_state_sha256": {"type": ["string", "null"]},
    "claim_ceiling": {"type": "string"},
    "warnings": {"type": "array", "items": {"type": "string"}}
  },
  "additionalProperties": true
}
