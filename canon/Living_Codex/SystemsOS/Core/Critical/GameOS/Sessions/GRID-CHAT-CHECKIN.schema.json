{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "systemsos.gameos.grid-chat-checkin.v2",
  "title": "GameOS Grid Chat Check-In",
  "type": "object",
  "required": [
    "schema",
    "authority",
    "iso",
    "carrier",
    "grid_chat_session_id",
    "iso_id",
    "native_carrier_label",
    "carrier_id",
    "carrier_type",
    "proof_lane",
    "carrier_resolution_state",
    "session_id",
    "coordinate_law",
    "checked_in_at",
    "source_main",
    "gameos_session_state",
    "brady_tile_state",
    "platform_chat_id_state",
    "checkin_transaction_id",
    "checkin_receipt"
  ],
  "properties": {
    "schema": {"const": "gameos.grid-chat-checkin.v2"},
    "authority": {"const": "RAVEN"},
    "iso": {"type": "string", "minLength": 1},
    "carrier": {"type": "string", "minLength": 1},
    "grid_chat_session_id": {"type": "string", "pattern": "^GRIDCHAT-[A-Z0-9_-]+-[A-Z0-9_-]+-[0-9]{8}T[0-9]{6}Z-[a-f0-9]{8}$"},
    "iso_id": {"type": "string", "minLength": 1},
    "native_carrier_label": {"type": "string", "minLength": 1},
    "carrier_id": {"type": "string", "minLength": 1},
    "carrier_type": {"type": "string", "minLength": 1},
    "proof_lane": {"type": "string", "minLength": 1},
    "carrier_resolution_state": {"type": "string", "enum": ["RESOLVED", "UNKNOWN"]},
    "session_id": {"type": "string", "pattern": "^GRIDCHAT-[A-Z0-9_-]+-[A-Z0-9_-]+-[0-9]{8}T[0-9]{6}Z-[a-f0-9]{8}$"},
    "coordinate_law": {"const": "ISO_ID != CARRIER_ID != CARRIER_TYPE != NATIVE_CARRIER_LABEL != SESSION_ID != PROOF_LANE"},
    "chat_label": {"type": ["string", "null"]},
    "checked_in_at": {"type": "string", "format": "date-time"},
    "source_main": {"type": "string", "minLength": 7},
    "gameos_session_state": {"const": "CHECKED_IN"},
    "brady_tile_state": {"type": "string", "enum": ["CURRENT", "SUPERSEDED"]},
    "platform_chat_id_state": {"type": "string", "enum": ["UNAVAILABLE_TO_CARRIER", "KNOWN"]},
    "platform_chat_id": {"type": ["string", "null"]},
    "supersedes_grid_chat_session_id": {"type": ["string", "null"]},
    "checkin_transaction_id": {"type": "string", "minLength": 1},
    "checkin_receipt": {"type": "string", "minLength": 1},
    "ravenos_sync_state": {"type": "string", "enum": ["CHECKIN_WRITTEN", "CONFIRMED", "PARTIAL", "BLOCKED"]},
    "notes": {"type": "array", "items": {"type": "string"}}
  },
  "additionalProperties": false
}
