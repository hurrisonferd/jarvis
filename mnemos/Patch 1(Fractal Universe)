3.7 LAZY WORLD EVALUATION ENGINE

function LOAD(chunk_id):
    if CACHE.exists(chunk_id):
        return CACHE.get(chunk_id)

    state = REGENERATE(chunk_id.seed, chunk_id.rules)
    CACHE.store(chunk_id, state)

    return state

