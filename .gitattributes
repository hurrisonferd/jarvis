docs/retroarch/player/overlays/** filter=lfs diff=lfs merge=lfs -text
docs/retroarch/player/shaders/**  filter=lfs diff=lfs merge=lfs -text
docs/retroarch/player/autoconfig/** filter=lfs diff=lfs merge=lfs -text
docs/retroarch/player/filters/**   filter=lfs diff=lfs merge=lfs -text
